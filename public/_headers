# Response headers for hosts that support the `_headers` convention
# (Cloudflare Pages, Netlify). GitHub Pages ignores this file, so it is
# inert today and starts working if the site is ever moved — no code change.
#
# A Content-Security-Policy is deliberately omitted: this site ships inline
# scripts and inline styles, so any policy would need 'unsafe-inline' and
# would add risk without adding protection. Move the zone behind Cloudflare
# or another edge that can serve real headers if a strict CSP is required.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin

# Build output is content-hashed, so it can be cached indefinitely.
# GitHub Pages serves this path with only `max-age=600`; a CDN in front of it
# is what actually makes the year-long cache below take effect.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed brand assets: long cache, but revalidated so an edit propagates.
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fingerprinted HTML must never be cached, or a deploy would not be visible.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
