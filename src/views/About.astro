---
import type { Locale } from '../i18n';
import { pick } from '../i18n';
import { t } from '../i18n/ui';
import { site } from '../data/site';
import { values, founder, founderTwo } from '../data/about';

import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;

---

<BaseLayout
  locale={locale}
  path={path}
  title={t('about.meta.title', locale)}
  description={t('about.meta.desc', locale)}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: t('about.meta.title', locale),
    mainEntity: {
      '@type': 'Organization',
      name: site.name,
      foundingDate: String(site.founded),
      email: site.email,
      telephone: site.phoneIntl,
    },
  }]}
>
  <PageHero
    locale={locale}
    path={path}
    eyebrow={t('about.eyebrow', locale)}
    title={t('about.title', locale)}
    sub={t('about.sub', locale)}
  />

  <!-- Founders -->
  <section class="section section--tint">
    <div class="container">
      <div class="founders-grid">
        <!-- Founder: Ismail Ahmed -->
        <div class="founder-card" data-reveal>
          <div class="founder-portrait" aria-hidden="true">
            <img
              src="/founders/ismail-ahmed.png"
              alt={t('about.founder.ismailAhmed', locale)}
              width={200}
              height={260}
            />
            <div class="founder-name">
              <span>{pick(founder.name, locale)}</span>
            </div>
          </div>
          <div class="founder-body">
            <p class="eyebrow-founder">{t('about.eyebrowFounderThree', locale)}</p>
            <blockquote class="founder-quote">
              <Icon name="quote" size={26} />
              <p>{pick(founder.quote, locale)}</p>
            </blockquote>
            <div class="founder-meta">
              <strong>{pick(founder.name, locale)}</strong>
              <span>{pick(founder.role, locale)}</span>
            </div>
            <p class="founder-bio">{pick(founder.bio, locale)}</p>
          </div>
        </div>

        <!-- Co-founder: Liu Li -->
        <div class="founder-card" data-reveal>
          <div class="founder-portrait" aria-hidden="true">
            <img
              src="/founders/liu-li.png"
              alt={t('about.founder.liuLi', locale)}
              width={200}
              height={260}
            />
            <div class="founder-name">
              <span>{pick(founderTwo.name, locale)}</span>
            </div>
          </div>
          <div class="founder-body">
            <p class="eyebrow-founder">{t('about.eyebrowFounderTwo', locale)}</p>
            <blockquote class="founder-quote">
              <Icon name="quote" size={26} />
              <p>{pick(founderTwo.quote, locale)}</p>
            </blockquote>
            <div class="founder-meta">
              <strong>{pick(founderTwo.name, locale)}</strong>
              <span>{pick(founderTwo.role, locale)}</span>
            </div>
            <p class="founder-bio">{pick(founderTwo.bio, locale)}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--tint">
    <div class="container">
      <SectionHead
        eyebrow={t('about.eyebrow', locale)}
        title={t('about.valuesTitle', locale)}
        sub={t('about.sub', locale)}
      />
      <div class="value-grid">
        {values.map((v) => (
          <article class="value-card" data-reveal>
            <span class="value-icon">
              <Icon name={v.icon} size={24} />
            </span>
            <h2>{pick(v.title, locale)}</h2>
            <p>{pick(v.body, locale)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABand locale={locale} />
</BaseLayout>
