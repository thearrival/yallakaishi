---
import type { Locale } from '../i18n';
import { localUrl, pick } from '../i18n';
import { t } from '../i18n/ui';
import { routes, site } from '../data/site';
import { plans } from '../data/engagement';
import { comparisonRows } from '../data/engagement';

import BaseLayout from '../components/BaseLayout.astro';
import PlanCard from '../components/PlanCard.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: `${site.url}/`,
  email: site.email,
  telephone: site.phoneIntl,
  description: t('meta.homeDesc', locale),
  areaServed: ['CN', 'SA', 'AE', 'QA', 'KW', 'BH', 'OM'],
  knowsLanguage: ['en', 'zh', 'ar'],
  openingHours: site.hours,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    addressCountry: 'CN',
  },
};
---

<BaseLayout
  locale={locale}
  path={path}
  title={t('meta.homeTitle', locale)}
  description={t('meta.homeDesc', locale)}
  branded={false}
  jsonLd={[orgLd]}
>
  <!-- ══════════ HERO ══════════ -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <span class="eyebrow">{t('home.hero.eyebrow', locale)}</span>
        <h1>{t('home.hero.title1', locale)}</h1>
        <p class="lede">{t('home.hero.sub', locale)}</p>

        <div class="hero-actions">
          <a class="btn btn--primary btn--lg" href="#brief">
            {t('home.hero.cta1', locale)}
            <Icon name="arrow" size={18} />
          </a>
          <a class="btn btn--secondary btn--lg" href={localUrl(locale, routes.contact)}>
            {t('home.hero.cta2', locale)}
          </a>
        </div>

        <div class="hero-meta">
          <div class="hero-meta-item">
            <span class="hero-meta-label">Response</span>
            <span class="hero-meta-value">{t('common.response', locale)}</span>
          </div>
          <div class="hero-meta-item">
            <span class="hero-meta-label">Languages</span>
            <span class="hero-meta-value">EN · 中文 · arabe</span>
          </div>
          <div class="hero-meta-item">
            <span class="hero-meta-label">Location</span>
            <span class="hero-meta-value">
              {t('home.panel.live', locale)} · {t('common.hoursValue', locale)}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ THREE PLANS ══════════ -->
  <section class="section section--alt" id="brief">
    <div class="container">
      <div class="sec-head sec-head--center">
        <span class="eyebrow">{t('home.services.eyebrow', locale)}</span>
        <h2>{t('home.services.title', locale)}</h2>
        <p class="lede">{t('home.services.sub', locale)}</p>
      </div>

      <div class="grid grid--3">
        {plans.map((p) => (
          <PlanCard plan={p} locale={locale} />
        ))}
      </div>

      <div style="margin-top: 4rem;">
        <h3 style="text-align: center; margin-bottom: 2rem;">{t('eng.compare', locale)}</h3>
        <table class="comparison-table">
          <thead>
            <tr>
              <th>{t('eng.mostPopular', locale)}</th>
              <th>{t('eng.capped', locale)}</th>
              <th>{t('eng.fixedFee', locale)}</th>
              <th>{t('common.viewAll', locale)}</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <td>{row.label[locale]}</td>
                {row.values.map((v) => (
                  <td>{pick(v, locale)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ══════════ CONTACT ══════════ -->
  <section class="section">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
        <div data-reveal>
          <span class="eyebrow">{t('contact.eyebrow', locale)}</span>
          <h2>{t('home.cta.title', locale)}</h2>
          <p style="color: var(--muted); margin-block: 1.5rem; line-height: 1.7;">
            {t('home.cta.body', locale)}
          </p>

          <ul style="display: flex; flex-direction: column; gap: 1rem; margin-block: 2rem;">
            <li style="display: flex; align-items: center; gap: 0.75rem; font-size: var(--fs-sm);">
              <Icon name="check" size={18} />
              <span>
                {t('eng.fixedFee', locale)} · {t('eng.capped', locale)}
              </span>
            </li>
            <li style="display: flex; align-items: center; gap: 0.75rem; font-size: var(--fs-sm);">
              <Icon name="check" size={18} />
              <span>
                {t('home.panel.foot', locale)} — {t('common.response', locale)}
              </span>
            </li>
            <li style="display: flex; align-items: center; gap: 0.75rem; font-size: var(--fs-sm);">
              <Icon name="check" size={18} />
              <span>EN · 中文 · arabe</span>
            </li>
          </ul>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a class="btn btn--secondary" href={`mailto:${site.email}`}>
              <Icon name="mail" size={17} /> {site.email}
            </a>
            <a class="btn btn--ghost" href={`tel:${site.phoneIntl}`}>
              <Icon name="phone" size={17} /> {site.phoneDisplay}
            </a>
          </div>
        </div>

        <div data-reveal>
          <p style="font-size: var(--fs-sm); font-weight: var(--w-medium); color: var(--ink); margin-block-end: 1.5rem;">
            {t('contact.formTitle', locale)}
          </p>
          <ContactForm locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
