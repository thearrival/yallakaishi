---
import type { Locale } from '../i18n';
import { localUrl, pick } from '../i18n';
import { t } from '../i18n/ui';
import { routes, site } from '../data/site';
import { coreServices } from '../data/services';
import { industries } from '../data/industries';
import { processSteps } from '../data/process';
import { faqs } from '../data/faq';
import { plans } from '../data/engagement';

import BaseLayout from '../components/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PlanCard from '../components/PlanCard.astro';
import FAQList from '../components/FAQList.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: `${site.url}/`,
  email: site.email,
  telephone: site.phoneIntl,
  description: t('meta.homeDesc', locale),
  areaServed: ['CN', 'SA', 'AE', 'QA', 'KW', 'BH', 'OM'],
  knowsLanguage: ['en', 'zh', 'ar'],
  openingHours: site.hours,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    addressCountry: 'CN',
  },
};
---

<BaseLayout
  locale={locale}
  path={path}
  title={t('meta.homeTitle', locale)}
  description={t('meta.homeDesc', locale)}
  branded={false}
  jsonLd={[orgLd]}
>
  <!-- ══════════ HERO ══════════ -->
  <section class="home-hero">
    <svg class="hero-shape" aria-hidden="true" width="420" height="420" viewBox="0 0 100 100">
      <path
        d="M22 12 Q22 6 28 9 L88 44 Q94 50 88 56 L28 91 Q22 94 22 88 Z"
        fill="#FF7A00"
        transform="rotate(-18 50 50)"
      ></path>
    </svg>

    <div class="hero-grid">
      <div class="hero-copy">
        <span class="chip">{t('home.hero.eyebrow', locale)}</span>
        <h1>
          <span class="hero-line">{t('home.hero.title1', locale)}</span>
          <span class="hero-line hero-line--accent">{t('home.hero.title2', locale)}</span>
        </h1>
        <p class="lede">{t('home.hero.sub', locale)}</p>

        <div class="hero-actions">
          <span class="magnetic">
            <a class="btn btn-primary btn-lg" href="#brief">
              {t('home.hero.cta1', locale)}
              <Icon name="arrow" size={18} />
            </a>
          </span>
          <span class="magnetic">
            <a class="btn btn-outline btn-lg" href={localUrl(locale, routes.services)}>
              {t('home.hero.cta2', locale)}
            </a>
          </span>
        </div>

        <ul class="hero-badges">
          <li>
            <Icon name="check" size={14} /> {t('common.response', locale)}
          </li>
          <li>
            <Icon name="check" size={14} /> {t('eng.fixedFee', locale)}
          </li>
          <li>
            <Icon name="check" size={14} /> EN · 中文 · العربية
          </li>
        </ul>

        <p class="hero-trust">
          <Icon name="pin" size={14} />
          <span>
            {t('home.panel.live', locale)} · {t('common.hoursValue', locale)}
          </span>
        </p>
      </div>

      <div class="logo-card" data-reveal>
        <img
          src="/logo.png"
          alt={`${site.name} 开始`}
          width="670"
          height="438"
          fetchpriority="high"
        />
        <div class="logo-tags">
          <span class="rg">{t('meta.tagline', locale)}</span>
          <span class="rg">{t('eng.fixedFee', locale)}</span>
          <span class="rg">EN · 中文 · العربية</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ STATS ══════════ -->
  <section class="section stats-band" id="stats" data-reveal>
    <div class="container">
      <div class="stats-grid">
        <div class="stat">
          <div class="stat-num" data-count="9">
            0
          </div>
          <div class="stat-label">{t('home.stats.projects', locale)}</div>
        </div>
        <div class="stat">
          <div class="stat-num" data-count="6">
            0
          </div>
          <div class="stat-label">{t('home.stats.services', locale)}</div>
        </div>
        <div class="stat">
          <div class="stat-num" data-count="3">
            0
          </div>
          <div class="stat-label">{t('home.stats.languages', locale)}</div>
        </div>
        <div class="stat">
          <div class="stat-num" data-count="24" data-suffix="h">
            0
          </div>
          <div class="stat-label">{t('home.stats.response', locale)}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ TWO-WAY BRIDGE ══════════ -->
  <section class="section" id="bridge">
    <div class="container">
      <SectionHead
        eyebrow={t('home.bridge.eyebrow', locale)}
        title={t('home.bridge.title', locale)}
        sub={t('home.bridge.sub', locale)}
      />

      <div class="bridge-pair">
        <article class="bridge-card" data-reveal>
          <span class="chip">{t('home.panel.leg1t', locale)}</span>
          <h2>{t('home.bridge.inTitle', locale)}</h2>
          <p>{t('home.panel.leg1d', locale)}</p>
          <div class="bridge-card-foot">
            <span>{t('home.panel.foot', locale)}</span>
            <a class="link-arrow" href={localUrl(locale, routes.chinaSupport)}>
              {t('nav.china', locale)} <Icon name="arrow" size={15} />
            </a>
          </div>
        </article>

        <article class="bridge-card" data-reveal>
          <span class="chip">{t('home.panel.leg2t', locale)}</span>
          <h2>{t('home.bridge.outTitle', locale)}</h2>
          <p>{t('home.panel.leg2d', locale)}</p>
          <div class="bridge-card-foot">
            <span>{t('home.panel.foot', locale)}</span>
            <a class="link-arrow" href={localUrl(locale, routes.services)}>
              {t('nav.services', locale)} <Icon name="arrow" size={15} />
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ══════════ SERVICES ══════════ -->
  <section class="section section--tint" id="services">
    <div class="container">
      <SectionHead
        eyebrow={t('home.services.eyebrow', locale)}
        title={t('home.services.title', locale)}
        sub={t('home.services.sub', locale)}
      >
        <a class="link-arrow" href={localUrl(locale, routes.services)}>
          {t('home.services.all', locale)} <Icon name="arrow" size={16} />
        </a>
      </SectionHead>

      <div class="svc-grid">
        {coreServices.map((s) => (
          <ServiceCard service={s} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ INDUSTRIES ══════════ -->
  <section class="section section--dark" id="industries">
    <div class="container">
      <SectionHead
        eyebrow={t('home.industries.eyebrow', locale)}
        title={t('home.industries.title', locale)}
        sub={t('home.industries.sub', locale)}
      >
        <a class="link-arrow" href={localUrl(locale, routes.industries)}>
          {t('common.viewAll', locale)} <Icon name="arrow" size={16} />
        </a>
      </SectionHead>

      <div class="industry-tiles">
        {industries.map((i) => (
          <a
            class="industry-tile"
            href={`${localUrl(locale, routes.industries)}${i.slug}/`}
            data-reveal
          >
            <span class="tile-index">{i.index}</span>
            <h2>{pick(i.name, locale)}</h2>
            <p>{pick(i.headline, locale)}</p>
            <span class="link-arrow">
              {t('common.more', locale)} <Icon name="arrow" size={15} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ MARQUEE ══════════ -->
  <section class="section section--tint" data-reveal>
    <div class="container">
      <div class="marquee">
        <div class="marquee-track">
          {Array.from({ length: 2 }).map(() => (
            <>
              <span class="marquee-item">
                <Icon name="check" size={14} /> Trading &amp; Distribution
              </span>
              <span class="marquee-item">
                <Icon name="check" size={14} /> Manufacturing
              </span>
              <span class="marquee-item">
                <Icon name="check" size={14} /> E-commerce &amp; Retail
              </span>
              <span class="marquee-item">
                <Icon name="check" size={14} /> Education &amp; Training
              </span>
              <span class="marquee-item">
                <Icon name="check" size={14} /> Hospitality &amp; F&amp;B
              </span>
              <span class="marquee-item">
                <Icon name="check" size={14} /> Technology &amp; Services
              </span>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ HOW IT WORKS ══════════ -->
  <section class="section" id="process">
    <div class="container">
      <SectionHead
        eyebrow={t('home.process.eyebrow', locale)}
        title={t('home.process.title', locale)}
        sub={t('home.process.sub', locale)}
      >
        <a class="link-arrow" href={localUrl(locale, routes.process)}>
          {t('process.meta.title', locale)} <Icon name="arrow" size={16} />
        </a>
      </SectionHead>

      <ol class="steps-grid">
        {processSteps.slice(0, 3).map((step) => (
          <li data-reveal>
            <div class="step-num">{step.index}</div>
            <h3>{pick(step.name, locale)}</h3>
            <p>{pick(step.summary, locale)}</p>
            <span class="rg">{pick(step.when, locale)}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════ PLANS ══════════ -->
  <section class="section plans-band" id="plans">
    <div class="container">
      <SectionHead
        eyebrow={t('home.engagement.eyebrow', locale)}
        title={t('home.engagement.title', locale)}
        sub={t('home.engagement.sub', locale)}
      >
        <a class="link-arrow" href={localUrl(locale, routes.engagement)}>
          {t('eng.compare', locale)} <Icon name="arrow" size={16} />
        </a>
      </SectionHead>

      <div class="plan-grid">
        {plans.map((p) => (
          <PlanCard plan={p} locale={locale} />
        ))}
      </div>

      <p class="plans-note">{t('eng.notIncludedNote', locale)}</p>
    </div>
  </section>

  <!-- ══════════ FAQ ══════════ -->
  <section class="section section--tint" id="faq">
    <div class="container container--narrow">
      <SectionHead
        eyebrow={t('home.faq.eyebrow', locale)}
        title={t('home.faq.title', locale)}
        align="center"
      />
      <FAQList items={faqs.slice(0, 6)} locale={locale} />
      <p class="faq-more">
        <a class="link-arrow" href={localUrl(locale, routes.faq)}>
          {t('faq.meta.title', locale)} · {t('common.viewAll', locale)}
          <Icon name="arrow" size={15} />
        </a>
      </p>
    </div>
  </section>

  <!-- ══════════ CONTACT ══════════ -->
  <section class="section home-contact" id="brief">
    <div class="container home-contact-grid">
      <div class="home-contact-copy" data-reveal>
        <p class="eyebrow">{t('contact.eyebrow', locale)}</p>
        <h2>{t('home.cta.title', locale)}</h2>
        <p>{t('home.cta.body', locale)}</p>

        <ul class="home-contact-points">
          <li>
            <Icon name="check" size={18} />
            <span>
              {t('eng.fixedFee', locale)} · {t('eng.capped', locale)}
            </span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>
              {t('home.panel.foot', locale)} — {t('common.response', locale)}
            </span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>EN · 中文 · العربية</span>
          </li>
        </ul>

        <div class="home-contact-direct">
          <a class="btn btn-outline" href={`mailto:${site.email}`}>
            <Icon name="mail" size={17} /> {site.email}
          </a>
          <a class="btn btn-ghost" href={`tel:${site.phoneIntl}`}>
            <Icon name="phone" size={17} /> {site.phoneDisplay}
          </a>
        </div>
      </div>

      <div class="home-contact-form" data-reveal>
        <p class="mini-label">{t('contact.formTitle', locale)}</p>
        <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
