---
import type { Locale } from '../i18n';
import { localUrl, pick } from '../i18n';
import { t } from '../i18n/ui';
import { routes, site } from '../data/site';
import { plans } from '../data/engagement';
import { comparisonRows } from '../data/engagement';

import BaseLayout from '../components/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PlanCard from '../components/PlanCard.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: `${site.url}/`,
  email: site.email,
  telephone: site.phoneIntl,
  description: t('meta.homeDesc', locale),
  areaServed: ['CN', 'SA', 'AE', 'QA', 'KW', 'BH', 'OM'],
  knowsLanguage: ['en', 'zh', 'ar'],
  openingHours: site.hours,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    addressCountry: 'CN',
  },
};
---

<BaseLayout
  locale={locale}
  path={path}
  title={t('meta.homeTitle', locale)}
  description={t('meta.homeDesc', locale)}
  branded={false}
  jsonLd={[orgLd]}
>
  <!-- PLANS HERO -->
  <section class="home-hero">
    <svg class="hero-shape" aria-hidden="true" width="420" height="420" viewBox="0 0 100 100">
      <path
        d="M22 12 Q22 6 28 9 L88 44 Q94 50 88 56 L28 91 Q22 94 22 88 Z"
        fill="#FF6A00"
        transform="rotate(-18 50 50)"
      ></path>
    </svg>

    <div class="hero-grid">
      <div class="hero-copy">
        <span class="chip">{t('home.hero.eyebrow', locale)}</span>
        <h1 data-word-reveal>
          <span class="hero-line">{t('home.hero.title1', locale)}</span>
          <span class="hero-line hero-line--accent">{t('home.hero.title2', locale)}</span>
        </h1>
        <p class="lede">{t('home.hero.sub', locale)}</p>

        <div class="hero-actions">
          <span class="magnetic">
            <a class="btn btn-primary btn-lg" href="#brief">
              {t('home.hero.cta1', locale)}
              <Icon name="arrow" size={18} />
            </a>
          </span>
          <span class="magnetic">
            <a class="btn btn-outline btn-lg" href={localUrl(locale, routes.contact)}>
              {t('home.hero.cta2', locale)}
            </a>
          </span>
        </div>

        <ul class="hero-badges">
          <li>
            <Icon name="check" size={14} /> {t('common.response', locale)}
          </li>
          <li>
            <Icon name="check" size={14} /> EN · 中文 · العربية
          </li>
        </ul>

        <p class="hero-trust">
          <Icon name="pin" size={14} />
          <span>
            {t('home.panel.live', locale)} · {t('common.hoursValue', locale)}
          </span>
        </p>
      </div>

      <div class="hero-panel" data-reveal>
        <div class="hero-panel-brand">
          <img
            src="/logo.png"
            alt={`${site.name} 开始`}
            width="670"
            height="438"
            fetchpriority="high"
          />
        </div>
        <p class="hero-panel-kicker">{t('meta.tagline', locale)}</p>
        <div class="hero-panel-steps">
          <div class="hero-panel-step">
            <span class="step-n">01</span>
            <div>
              <strong>{t('contact.step1t', locale)}</strong>
              <p>{t('contact.step1d', locale)}</p>
            </div>
          </div>
          <div class="hero-panel-step">
            <span class="step-n">02</span>
            <div>
              <strong>{t('contact.step2t', locale)}</strong>
              <p>{t('contact.step2d', locale)}</p>
            </div>
          </div>
          <div class="hero-panel-step">
            <span class="step-n">03</span>
            <div>
              <strong>{t('contact.step3t', locale)}</strong>
              <p>{t('contact.step3d', locale)}</p>
            </div>
          </div>
        </div>
        <div class="hero-panel-foot">
          <span>
            <Icon name="check" size={14} /> {t('common.response', locale)}
          </span>
          <span>
            <Icon name="check" size={14} /> EN · 中文 · العربية
          </span>
        </div>
      </div>
    </div>
    <a href="#brief" class="scroll-cue" aria-label="Scroll to content">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
      <span>Scroll</span>
    </a>
  </section>

  <!-- ══════════ TRUST STRIP ══════════ -->
  <section class="trust-strip" aria-label="Key promises">
    <div class="container trust-strip-grid">
      <div class="trust-item" data-reveal>
        <span class="trust-icon">
          <Icon name="clock" size={20} />
        </span>
        <div>
          <strong>{t('common.response', locale)}</strong>
          <p>{t('contact.step2d', locale)}</p>
        </div>
      </div>
      <div class="trust-item" data-reveal>
        <span class="trust-icon">
          <Icon name="translate" size={20} />
        </span>
        <div>
          <strong>EN · 中文 · العربية</strong>
          <p>{t('home.panel.foot', locale)}</p>
        </div>
      </div>
      <div class="trust-item" data-reveal>
        <span class="trust-icon">
          <Icon name="pin" size={20} />
        </span>
        <div>
          <strong>{t('home.panel.live', locale)}</strong>
          <p>{t('common.hoursValue', locale)}</p>
        </div>
      </div>
      <div class="trust-item" data-reveal>
        <span class="trust-icon">
          <Icon name="shield" size={20} />
        </span>
        <div>
          <strong>{t('eng.fixedFee', locale)}</strong>
          <p>{t('eng.capped', locale)}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ THREE PLANS ══════════ -->
  <section class="section section--tint" id="brief">
    <div class="container">
      <SectionHead
        eyebrow={t('home.services.eyebrow', locale)}
        title={t('home.services.title', locale)}
        sub={t('home.services.sub', locale)}
      >
        <a class="link-arrow" href={localUrl(locale, routes.engagement)}>
          {t('home.services.all', locale)} <Icon name="arrow" size={16} />
        </a>
      </SectionHead>

      <div class="plan-grid">
        {plans.map((p) => (
          <PlanCard plan={p} locale={locale} />
        ))}
      </div>

      <div class="plan-comparison">
        <h3>{t('eng.compare', locale)}</h3>
        <div class="comparison-table">
          <div class="comparison-row">
            <span></span>
            {plans.map((p) => (
              <span>{p.name[locale]}</span>
            ))}
          </div>
          {comparisonRows.map((row, i) => (
            <div class="comparison-row">
              <span>{row.label[locale]}</span>
              {row.values.map((v) => (
                <span>{pick(v, locale)}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ HOW WE WORK ══════════ -->
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow={t('contact.nextSteps', locale)}
        title={t('contact.nextSteps', locale)}
        sub={t('contact.sub', locale)}
        align="center"
      />
      <div class="how-grid">
        <article class="how-card" data-reveal>
          <span class="how-n">01</span>
          <h3>{t('contact.step1t', locale)}</h3>
          <p>{t('contact.step1d', locale)}</p>
        </article>
        <article class="how-card" data-reveal>
          <span class="how-n">02</span>
          <h3>{t('contact.step2t', locale)}</h3>
          <p>{t('contact.step2d', locale)}</p>
        </article>
        <article class="how-card" data-reveal>
          <span class="how-n">03</span>
          <h3>{t('contact.step3t', locale)}</h3>
          <p>{t('contact.step3d', locale)}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══════════ CONTACT ══════════ -->
  <section class="section home-contact section--tint">
    <div class="container home-contact-grid">
      <div class="home-contact-copy" data-reveal>
        <p class="eyebrow">{t('contact.eyebrow', locale)}</p>
        <h2>{t('home.cta.title', locale)}</h2>
        <p>{t('home.cta.body', locale)}</p>

        <ul class="home-contact-points">
          <li>
            <Icon name="check" size={18} />
            <span>
              {t('eng.fixedFee', locale)} · {t('eng.capped', locale)}
            </span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>
              {t('home.panel.foot', locale)} — {t('common.response', locale)}
            </span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>EN · 中文 · العربية</span>
          </li>
        </ul>

        <div class="home-contact-direct">
          <a class="btn btn-outline" href={`mailto:${site.email}`}>
            <Icon name="mail" size={17} /> {site.email}
          </a>
          <a class="btn btn-ghost" href={`tel:${site.phoneIntl}`}>
            <Icon name="phone" size={17} /> {site.phoneDisplay}
          </a>
        </div>
      </div>

      <div class="home-contact-form" data-reveal>
        <p class="mini-label">{t('contact.formTitle', locale)}</p>
        <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
