---
import type { Locale } from '../i18n';
import { localUrl } from '../i18n';
import { t } from '../i18n/ui';
import { routes } from '../data/site';
import { coreServices } from '../data/services';

import BaseLayout from '../components/BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface Props {
  locale: Locale;
  path?: string;
}
const { locale, path = '/' } = Astro.props;
---

<BaseLayout
  locale={locale}
  path={path}
  title={`${t('404.code', locale)} · ${t('404.title', locale)}`}
  description={t('404.body', locale)}
  noindex
>
  <section class="notfound">
    <div class="container container--narrow notfound-inner">
      <p class="notfound-code" aria-hidden="true">
        {t('404.code', locale)}
      </p>
      <h1>{t('404.title', locale)}</h1>
      <p class="lede">{t('404.body', locale)}</p>

      <div class="center-actions">
        <a class="btn btn-primary btn-lg" href={localUrl(locale, '/')}>
          {t('common.backHome', locale)} <Icon name="arrow" size={18} />
        </a>
        <a class="btn btn-outline btn-lg" href={localUrl(locale, routes.services)}>
          {t('404.searchServices', locale)}
        </a>
      </div>

      <div class="notfound-links">
        <p class="mini-label">{t('nav.services', locale)}</p>
        <ul class="chip-row">
          {coreServices.map((s) => (
            <li>
              <a class="chip chip--link" href={localUrl(locale, routes.services)}>
                {s.title[locale]}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
