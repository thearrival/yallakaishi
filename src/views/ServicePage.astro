---
import type { Locale } from '../i18n';
import { localUrl, localeMeta, pick } from '../i18n';
import { t } from '../i18n/ui';
import { routes, site } from '../data/site';
import { coreServices } from '../data/services';

import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';

interface Props {
  locale: Locale;
  path: string;
  slug: string;
}
const { locale, path, slug } = Astro.props;
const service = coreServices.find((s) => s.slug === slug);

const contactHref = `${localUrl(locale, routes.contact)}#brief`;
const name = service ? pick(service.title, locale) : '';
const desc = service ? pick(service.summary, locale) : '';
---

{service && (
  <BaseLayout
    locale={locale}
    path={path}
    title={name}
    description={desc}
    jsonLd={[
      {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name,
        description: desc,
        inLanguage: localeMeta[locale].code,
        areaServed: ['CN', 'SA', 'AE', 'QA', 'KW', 'BH', 'OM'],
        provider: { '@type': 'Organization', name: site.name },
      },
    ]}
  >
    <PageHero
      locale={locale}
      path={path}
      eyebrow={t('services.eyebrow', locale)}
      title={name}
      sub={pick(service.summary, locale)}
    >
      <div class="hero-actions">
        <a class="btn btn-primary" href={contactHref}>
          {t('common.requestProposal', locale)} <Icon name="arrow" size={17} />
        </a>
      </div>
    </PageHero>

    <section class="section section--flush">
      <div class="container container--reading">
        <div class="detail-intro" data-reveal>
          <span class="detail-icon">
            <Icon name={service.icon} size={26} />
          </span>
          <p>{pick(service.body, locale)}</p>
        </div>

        <div class="detail-blocks">
          <div class="detail-block" data-reveal>
            <p class="mini-label">{t('services.deliverTitle', locale)}</p>
            <ul class="tick-list tick-list--two">
              {service.deliverables.map((d) => (
                <li>
                  <Icon name="check" size={15} />
                  <span>{pick(d, locale)}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="detail-block detail-block--muted" data-reveal>
            <p class="mini-label">{t('services.timeTitle', locale)}</p>
            <p class="detail-time">{pick(service.timeline, locale)}</p>
          </div>
        </div>
      </div>
    </section>

    <CTABand locale={locale} />
  </BaseLayout>
)}
