---
import { localUrl, type Locale } from '../i18n';
import { t } from '../i18n/ui';
import { staticRoutes } from '../routes';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  path: string;
  eyebrow?: string;
  title: string;
  sub?: string;
}
const { locale, path, eyebrow, title, sub } = Astro.props;

const segments = path.split('/').filter(Boolean);

/**
 * An ancestor is only a link when that path is a real page. `/legal/` has no
 * index, so linking to it produced a 404 from every legal page.
 */
const isRoute = (p: string) =>
  (staticRoutes as readonly string[]).includes(p.replace(/^\/+|\/+$/g, ''));

/** Real names for the sections that appear as breadcrumb ancestors. */
const parentLabel: Record<string, string> = {
  services: t('nav.services', locale),
  'china-support': t('nav.china', locale),
  industries: t('nav.industries', locale),
  insights: t('nav.insights', locale),
  legal: t('legal.eyebrow', locale),
};

const crumbs = segments.map((seg, i) => {
  const routePath = '/' + segments.slice(0, i + 1).join('/');
  const isCurrent = i === segments.length - 1;
  return {
    href: isCurrent ? '' : localUrl(locale, routePath + '/'),
    linkable: !isCurrent && isRoute(routePath),
    label: isCurrent ? title : (parentLabel[seg] ?? seg.replace(/-/g, ' ')),
  };
});
---

<section class="page-hero">
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumb" aria-label={t('common.breadcrumb', locale)}>
        <ol>
          <li>
            <a href={localUrl(locale, '/')}>{t('common.home', locale)}</a>
          </li>
          {crumbs.map((c) => (
            <li>
              <Icon name="arrow" size={12} />
              {c.href === '' ? (
                <span aria-current="page">{c.label}</span>
              ) : c.linkable ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span>{c.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="page-hero-inner">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {sub && <p class="lede">{sub}</p>}
      <slot />
    </div>
  </div>
  <div class="page-hero-glow" aria-hidden="true"></div>
</section>
