---
interface Props {
  /** pixel size of the square mark */
  size?: number;
  /** unique gradient id — must differ per instance inside one document */
  gradId: string;
  class?: string;
}
const { size = 28, gradId, class: className = '' } = Astro.props;
const stroke = `url(#${gradId})`;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradId} x1="4" y1="10" x2="28" y2="24" gradientUnits="userSpaceOnUse">
      <stop stop-color="#e6b45a"></stop>
      <stop offset="0.5" stop-color="#c08a2e"></stop>
      <stop offset="1" stop-color="#0f766e"></stop>
    </linearGradient>
  </defs>
  <!-- bridge deck -->
  <path
    d="M4.5 21.5h23"
    stroke={stroke}
    stroke-width="2.2"
    stroke-linecap="round"
    opacity="0.55"
  ></path>
  <!-- bridge arch -->
  <path
    d="M4.5 21.5C8 11 24 11 27.5 21.5"
    stroke={stroke}
    stroke-width="2.6"
    stroke-linecap="round"
  ></path>
  <!-- two ends of the corridor -->
  <circle cx="4.5" cy="21.5" r="2.9" fill="#e6b45a"></circle>
  <circle cx="27.5" cy="21.5" r="2.9" fill="#0f766e"></circle>
  <!-- midpoint -->
  <circle cx="16" cy="13.6" r="1.8" fill={stroke}></circle>
</svg>
