---
interface Props {
  /** pixel size of the square mark */
  size?: number;
  /** unique gradient id — must differ per instance inside one document */
  gradId: string;
  class?: string;
}
const { size = 28, gradId, class: className = '' } = Astro.props;
const stroke = `url(#${gradId})`;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradId} x1="4" y1="3" x2="28" y2="29" gradientUnits="userSpaceOnUse">
      <stop stop-color="#e6b45a"></stop>
      <stop offset="0.55" stop-color="#c08a2e"></stop>
      <stop offset="1" stop-color="#0f766e"></stop>
    </linearGradient>
  </defs>
  <path
    d="M16 2.6 27.6 9.3v13.4L16 29.4 4.4 22.7V9.3z"
    stroke={stroke}
    stroke-width="2.1"
    stroke-linejoin="round"
  ></path>
  <path
    d="M11.2 12.4 16 17.3l4.8-4.9M16 17.3V23"
    stroke={stroke}
    stroke-width="2.1"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <circle cx="11.2" cy="12.4" r="2.1" fill="#e6b45a"></circle>
  <circle cx="20.8" cy="12.4" r="2.1" fill="#0f766e"></circle>
  <circle cx="16" cy="23" r="2.1" fill="#c08a2e"></circle>
</svg>
