---
import { localUrl, type Locale, locales, localeMeta } from '../i18n';
import { t, type TKey } from '../i18n/ui';
import { routes, site, type RouteKey } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;

const col = (keys: { route: RouteKey; label: TKey }[]) =>
  keys.map((k) => ({ href: localUrl(locale, routes[k.route]), label: t(k.label, locale) }));

const explore = col([
  { route: 'services', label: 'nav.services' },
  { route: 'chinaSupport', label: 'nav.china' },
  { route: 'industries', label: 'nav.industries' },
  { route: 'engagement', label: 'nav.engagement' },
  { route: 'cases', label: 'cases.eyebrow' },
]);

const company = col([
  { route: 'about', label: 'nav.about' },
  { route: 'process', label: 'process.meta.title' },
  { route: 'faq', label: 'faq.meta.title' },
  { route: 'contact', label: 'nav.contact' },
]);

const resources = col([
  { route: 'insights', label: 'nav.insights' },
  { route: 'privacy', label: 'foot.privacy' },
  { route: 'terms', label: 'foot.terms' },
  { route: 'disclaimer', label: 'foot.disclaimerPage' },
]);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand brand--footer" href={localUrl(locale, '/')}>
        <span class="brand-mark" aria-hidden="true">
          <Logo size={26} gradId="yk-grad-ftr" />
        </span>
        <strong>{site.name}</strong>
      </a>
      <p>{t('foot.tagline', locale)}</p>

      <div class="footer-langs" role="group" aria-label={t('nav.language', locale)}>
        {locales.map((l) => (
          <a
            class:list={['lang-chip', { 'is-active': l === locale }]}
            href={localUrl(l, path)}
            hreflang={localeMeta[l].code}
            lang={localeMeta[l].code}
            aria-current={l === locale ? 'true' : undefined}
          >
            {localeMeta[l].native}
          </a>
        ))}
      </div>
    </div>

    <nav class="footer-col" aria-label={t('foot.explore', locale)}>
      <h2>{t('foot.explore', locale)}</h2>
      <ul>
        {explore.map((i) => (
          <li>
            <a href={i.href}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t('foot.company', locale)}>
      <h2>{t('foot.company', locale)}</h2>
      <ul>
        {company.map((i) => (
          <li>
            <a href={i.href}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t('foot.resources', locale)}>
      <h2>{t('foot.resources', locale)}</h2>
      <ul>
        {resources.map((i) => (
          <li>
            <a href={i.href}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-col footer-contact">
      <h2>{t('foot.contact', locale)}</h2>
      <ul>
        <li class="footer-copy-row">
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" size={16} />
            <span>{site.email}</span>
          </a>
          <button
            class="copy-btn"
            type="button"
            data-copy={site.email}
            data-done={t('common.copied', locale)}
            data-label={t('common.copyEmail', locale)}
            aria-label={t('common.copyEmail', locale)}
          >
            <Icon name="copy" size={14} />
          </button>
        </li>
        <li>
          <a href={`tel:${site.phoneIntl}`}>
            <Icon name="phone" size={16} />
            <span>{site.phoneDisplay}</span>
          </a>
        </li>
        <li>
          <span class="footer-addr">
            <Icon name="pin" size={16} />
            <span>
              {site.address.street}, {site.address.city}, {site.address.country}
            </span>
          </span>
        </li>
        <li>
          <span class="footer-addr">
            <Icon name="clock" size={16} />
            <span>{t('common.hoursValue', locale)}</span>
          </span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bar">
    <p>
      © {year} {site.name}. {t('common.allRights', locale)}
    </p>
    <p class="footer-disclaimer">{t('common.notLegalAdvice', locale)}</p>
  </div>
</footer>

<script is:inline>
  (function () {
    var icons = {
      copy: '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15V5h10M9 9h10v10H9z"/></svg>',
      check:
        '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4.5 4.5L19 7"/></svg>',
    };
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-copy]');
      if (!btn) return;
      var text = btn.getAttribute('data-copy');
      var done = btn.getAttribute('data-done') || 'Copied';
      var restore = function () {
        btn.classList.remove('is-done');
        btn.innerHTML = icons.copy;
      };
      var flash = function () {
        btn.classList.add('is-done');
        btn.innerHTML = icons.check + '<span>' + done + '</span>';
        clearTimeout(btn._t);
        btn._t = setTimeout(restore, 2200);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(flash, restore);
      } else {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          var legacy = /** @type {any} */ (document).execCommand;
          if (legacy) legacy.call(document, 'copy');
          flash();
        } catch (err) {
          restore();
        }
        document.body.removeChild(ta);
      }
    });
  })();
</script>
