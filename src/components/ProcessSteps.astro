---
import type { ProcessStep } from '../data/process';
import { pick, type Locale } from '../i18n';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  steps: ProcessStep[];
  locale: Locale;
  showDetail?: boolean;
}
const { steps, locale, showDetail = true } = Astro.props;
---

<ol class="process">
  {steps.map((s) => (
    <li class="process-step" data-reveal>
      <div class="process-marker">
        <span class="process-num">{s.index}</span>
        <span class="process-icon">
          <Icon name={s.icon} size={22} />
        </span>
        <span class="process-line" aria-hidden="true"></span>
      </div>
      <div class="process-body">
        <p class="process-when">{pick(s.when, locale)}</p>
        <h3>{pick(s.name, locale)}</h3>
        <p class="process-summary">{pick(s.summary, locale)}</p>
        {showDetail && <p class="process-detail">{pick(s.detail, locale)}</p>}
        <div class="process-youget">
          <p class="mini-label">{t('process.whatNext', locale)}</p>
          <ul>
            {s.youGet.map((y) => (
              <li>
                <Icon name="check" size={15} />
                <span>{pick(y, locale)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </li>
  ))}
</ol>
