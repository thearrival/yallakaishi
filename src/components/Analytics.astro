---
/**
 * Cloudflare Web Analytics — cookieless, no personal data, no cross-site tracking.
 *
 * Inactive until a token is supplied, so the site carries no third-party script
 * by default. Set the token in `.env` (local) and as a repository secret
 * (Actions) before building:
 *
 *   PUBLIC_CF_BEAMON_TOKEN=<token from Cloudflare dashboard>
 *
 * The token is site-specific and issued when the zone is enabled in Cloudflare.
 */
const token = import.meta.env.PUBLIC_CF_BEAMON_TOKEN ?? '';
const enabled = import.meta.env.PROD && token.length > 0;
---

{enabled && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token })}
  />
)}
