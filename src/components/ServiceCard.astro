---
import type { CoreService } from '../data/services';
import { localUrl, pick, type Locale } from '../i18n';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  service: CoreService;
  locale: Locale;
  compact?: boolean;
}
const { service, locale, compact = false } = Astro.props;
const href = `${localUrl(locale, service.href)}#brief`;
---

<article class:list={['svc-card', { 'svc-card--compact': compact }]} data-reveal>
  <div class="svc-card-top">
    <span class="svc-icon">
      <Icon name={service.icon} size={26} />
    </span>
    <span class="svc-index">{service.index}</span>
  </div>
  <h2>{pick(service.title, locale)}</h2>
  <p class="svc-summary">{pick(service.summary, locale)}</p>

  {!compact && (
    <ul class="svc-list">
      {service.deliverables.slice(0, 3).map((d) => (
        <li>
          <Icon name="check" size={15} />
          <span>{pick(d, locale)}</span>
        </li>
      ))}
    </ul>
  )}

  <footer class="svc-foot">
    <span class="svc-time">
      <Icon name="clock" size={14} /> {pick(service.timeline, locale)}
    </span>
    <a class="link-arrow" href={href}>
      {t('common.requestService', locale)}
      <Icon name="arrow" size={15} />
    </a>
  </footer>
</article>
