---
import type { Plan } from '../data/engagement';
import { localUrl, pick, type Locale } from '../i18n';
import { t } from '../i18n/ui';

interface Props {
  plan: Plan;
  locale: Locale;
}
const { plan, locale } = Astro.props;
---

<article class:list={['plan-card', { 'plan-card--featured': plan.popular }]} data-reveal>
  {plan.popular && <span class="plan-card-badge">{t('eng.mostPopular', locale)}</span>}

  <div class="plan-card-header">
    <span class="plan-card-name">{pick(plan.name, locale)}</span>
    <p class="plan-card-duration">{pick(plan.tagline, locale)}</p>
  </div>

  <p style="font-size: var(--fs-sm); color: var(--muted); margin-block-end: 1.5rem;">
    <strong style="display: block; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--accent); margin-block-end: 0.375rem;">
      {t('eng.includes', locale)}
    </strong>
    {pick(plan.bestFor, locale)}
  </p>

  <ul class="plan-card-features">
    {plan.includes.map((i) => (
      <li class="plan-card-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>{pick(i, locale)}</span>
      </li>
    ))}
  </ul>

  <a
    class:list={['btn', plan.popular ? 'btn--accent' : 'btn--secondary']}
    href={`${localUrl(locale, '/contact/')}#brief`}
  >
    {t('common.requestProposal', locale)}
  </a>
</article>
